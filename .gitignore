# Secrets — never commit
.env
.env.local
.env.*.local

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Backend
__pycache__/
*.pyc
*.pyo
.pytest_cache/
backend/venv/
backend/.venv/

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# macOS
.DS_Store

# Uploaded user data files (server-side storage)
data/

# Tauri / Rust build output
src-tauri/target/
# gen/schemas is regenerated at build; gen/apple is COMMITTED (mobile-app
# schema §2.1 — it holds hand-edited state: project.yml, Info.plist,
# ExportOptions, entitlements). Build products inside gen/apple are excluded
# by the .gitignore tauri ios init drops there (xcuserdata/build/Externals).
src-tauri/gen/schemas/

# Root package manager
node_modules/
