[Unit]
Description=SnowRaven weather lookup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/snowraven/backend
EnvironmentFile=/home/pi/snowraven/backend/.env
ExecStart=/home/pi/snowraven/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 1620
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
