# The Android toolchain pins (android-release schema 6.0), sourced by
# .github/workflows/android-build.yml and the release Mac's scripts, and mirrored
# as literals in the F-Droid recipe (which cannot read the repository before the
# clone). Guards hold the recipe, the workflow, package-lock.json and
# gradle-wrapper.properties to these values. Change them together, deliberately.
RUST_TOOLCHAIN=1.96.1
RUST_TARGETS="aarch64-linux-android armv7-linux-androideabi x86_64-linux-android"
TAURI_CLI_VERSION=2.11.2
GRADLE_VERSION=8.14.3
NDK_VERSION=27.2.12479018
JAVA_VERSION=17
NODE_MAJOR=20
SDK_PLATFORM=36
BUILD_TOOLS=36.0.0
