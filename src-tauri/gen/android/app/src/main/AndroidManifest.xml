<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The permission set follows the location branch (android-release schema
         3.4 and 4.6; frontend/src/lib/androidLocation.ts), and
         androidProjectPins.test.ts pins it to ANDROID_LOCATION_BRANCH. Branch B
         (in force): INTERNET only, for the provider requests the user asks for.
         With the geolocation plugin out of the Android build, nothing merges a
         location permission in. Branch A would add ACCESS_COARSE_LOCATION and
         ACCESS_FINE_LOCATION here, explicitly, because wry's chrome client
         requests both at runtime and Android refuses an undeclared one. Never
         background location, storage, media, camera or notifications. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.snowraven"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- Android System WebView's Safe Browsing is on by default and runs in
             the app's own process: it checks the URLs the page loads with
             Google's service (android-release QA-52, NFR-01). SnowRaven loads
             only its own bundled page and the provider APIs it names, so the
             check is turned off for this app's WebView. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
        <!-- The WebView uploads usage statistics for this app on phones whose
             owner consented to usage and diagnostics reporting. This is the
             documented application-level opt-out for every user of this app;
             it does not touch crash reports (android-release security M3). -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- AndroidX's startup provider (merged in by appcompat) runs the
             emoji2 initializer at every launch, which asks the phone's font
             provider for "Noto Color Emoji Compat"; on a phone with Play
             services that provider is com.google.android.gms.fonts, an IPC
             from this app's process to a Google service (android-release
             security M2, measured in measurements/emoji-initializer/). The
             WebView draws its own text and emoji and no native text view shows
             content, so the initializer is removed from the merged manifest.
             The lifecycle and profile-installer initializers stay. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
