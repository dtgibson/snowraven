<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- API 31 and later (android-release design-spec section 1): the platform
         splash shows the adaptive icon's foreground on SnowRaven green, with no
         icon background, no branding image, no splash library and no fixed
         wait; it yields when the Activity first draws. The window background
         behind it is the plain green, the same in light and dark. This file is
         identical to values-v31 and exists because night mode outranks the API
         level in resource selection: without it a dark system theme would fall
         back to values-night and lose these. -->
    <style name="Theme.snowraven" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
