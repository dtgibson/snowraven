{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnowRaven",
  "version": "1.0.16",
  "identifier": "com.snowraven",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "SnowRaven",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2MzYzM0JGQjYzMENGOApSV1Q0REdQN08yTmpCdkpLNS9GQjZFajB5ZmF1TFVTY254SExKVEU5cWhtSW1iVW4xdyswU2ZaVgo=",
      "endpoints": [
        "https://github.com/dtgibson/snowraven/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
